# Copy settings into .env.local. Keep all real credentials out of Git.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/POS-DB?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
# Canonical application origin; keep BETTER_AUTH_URL the same. HTTPS on deployment.
APP_URL="http://localhost:3000"
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
RESEND_API_KEY=""
# Production: sender on your verified Resend domain. Development defaults to onboarding@resend.dev.
RESEND_FROM_EMAIL=""
# Optional administrator contact / Reply-To address, never used as the sender.
ADMIN_EMAIL=""
# Standalone connectivity test only: use your Resend account email with onboarding@resend.dev.
RESEND_TEST_EMAIL=""
# Legacy fallback only; RESEND_FROM_EMAIL takes precedence.
EMAIL_FROM=""
